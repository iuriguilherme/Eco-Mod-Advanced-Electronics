<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Advanced Electronics survey-drone mod (real project; the feasibility spike at
    ../AdvancedElectronics.Spike stays a reference-only sibling per KTD1, not a base
    class of this project).

    EcoRefVersion must match the target Eco dedicated server's build. There is no
    Eco.ReferenceAssemblies package for 0.14, and the shipped server is a single-file
    bundle with its managed assemblies embedded, so the reference assemblies are built
    from a source checkout instead. See ../../scripts/gather-eco-refs.sh.

    EcoRefSha pins that checkout. It is the single source of truth for the pin: the
    gather script reads it from here rather than carrying its own copy. `staging` moves
    daily, and a mod tracking a moving branch has no reproducible build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EcoRefVersion>0.14.0.0</EcoRefVersion>
    <EcoRefSha>07370cde2505f6b916d0476ddf5a1d12a51bdcbb</EcoRefSha>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Machine-local paths (EcoRefAssembliesDir, EcoModsDir). Git-ignored. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <Target Name="RequireEcoRefAssembliesDir" BeforeTargets="BeforeBuild"
          Condition="'$(EcoRefAssembliesDir)' == ''">
    <Error Text="EcoRefAssembliesDir is not set. Run scripts/gather-eco-refs.sh against an Eco checkout at $(EcoRefSha), then set EcoRefAssembliesDir (trailing separator required) in Local.props to the directory it prints." />
  </Target>

  <!--
    Private=false keeps Strange Loop Games' assemblies out of bin/, which the release
    packaging script stages wholesale. Shipping them would redistribute their SDK.
  -->
  <ItemGroup>
    <Reference Include="$(EcoRefAssembliesDir)*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Shelved, not deleted. The Advanced Electronics Assembly hosted every recipe this mod had
    until the drone and dock moved to the Robotic Assembly Line and the upgrade module to the
    Electronics Assembly, which left it with nothing to craft. The file is kept current with the
    v14 table shape so it can come back the moment there is a recipe that wants its own bench.

    Excluding it removes the item and its world object from the mod, so any already placed in a
    world will not load. See the release notes' known-issues block.
  -->
  <ItemGroup>
    <Compile Remove="AdvancedElectronicsAssembly.cs" />
  </ItemGroup>

  <!-- U2: consumes GridPathfinder/PathResult/ArrivalDetector (U3) via EcoWorldSampler. -->
  <ItemGroup>
    <ProjectReference Include="..\AdvancedElectronics.Navigation\AdvancedElectronics.Navigation.csproj" />
  </ItemGroup>

  <!-- Optional auto-deploy: set EcoModsDir in Local.props to your server's
       Mods/AdvancedElectronics directory to copy the DLLs after every build. Copies every
       DLL in the output (the mod itself plus AdvancedElectronics.Navigation,
       which the mod cannot load without) rather than only $(TargetPath). -->
  <Target Name="CopyModToEco" AfterTargets="Build" Condition="'$(EcoModsDir)' != ''">
    <ItemGroup>
      <ModOutputDlls Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ModOutputDlls)" DestinationFolder="$(EcoModsDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
